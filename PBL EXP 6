#include<iostream>
using namespace std;
class complex
{ 
    int real, imag;
public:

  complex(int r = 0, int i = 0)

    {

        real=r;

        imag=i;

    }

    void display( );

    complex operator/(complex);

};

void complex::display( )

{
    int i;

    if(imag>0)

        cout<<real<<"+i"<<imag<<endl;

    else

    {

        i=-imag;

        cout<<real<<"-i"<<i<<endl;

    }

}

complex complex::operator/(complex c1)

{

    complex div;

    int denominator;

    denominator = c1.real*c1.real + c1.imag*c1.imag;

    div.real = (real*c1.real + imag*c1.imag)/denominator;

    div.imag = (imag*c1.real - real*c1.imag)/denominator;

    return(div);

}

int main()

{

    complex c1(4,6),c2(2,3),c3;

    c3=c1/c2;

    cout<<"division is ";

    c3.display();

    return 0;

}
